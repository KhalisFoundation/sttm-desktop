{
  "sidebar": {
    "categories": {
      "themes": {
        "title": "THEME_HEADING",
        "type": "title",
        "subcategories": ["theme-options"]
      },
      "theme-options": {
        "title": "",
        "type": "custom",
        "settings": ["overlay-theme"]
      },
      "gurbani": {
        "title": "GURBANI",
        "type": "title",
        "subcategories": ["gurbani-options"]
      },
      "gurbani-options": {
        "title": "",
        "type": "dropdown",
        "settings": ["gurbani-font", "gurbani-text-color", "gurbani-size"]
      },
      "translation": {
        "title": "TRANSLATION",
        "type": "title",
        "subcategories": ["text-options", "text-format-options"]
      },
      "text-options": {
        "title": "",
        "type": "dropdown",
        "settings": ["text-font", "text-color", "text-size"]
      },
      "text-format-options": {
        "title": "",
        "type": "icon-toggle",
        "settings": ["text-format"]
      },
      "background": {
        "title": "BACKGROUND",
        "type": "title",
        "subcategories": ["background-options"]
      },
      "background-options": {
        "title": "",
        "type": "size-icon",
        "settings": ["bg-color", "padding", "bg-opacity"]
      },
      "larivaar-title": {
        "title": "LARIVAAR",
        "type": "title",
        "subcategories": ["larivaar-options"]
      },
      "larivaar-options": {
        "title": "",
        "type": "switch",
        "settings": ["overlayLarivaar", "larivaarAssist"]
      },
      "date-time": {
        "title": "DATE_AND_TIME",
        "toggle": true,
        "subcategories": ["date-time-options"]
      },
      "date-time-options": {
        "title": "",
        "type": "dropdown",
        "settings": ["date-format", "time-format"]
      },
      "advanced-options": {
        "title": "ADVANCED_OPTIONS",
        "type": "title",
        "subcategories": ["advanced-settings"]
      },
      "advanced-settings": {
        "title": "",
        "type": "switch",
        "settings": ["fit-text-switch", "toggle-announcement"]
      }
    },
    "settings": {
      "gurbani-text-color": {
        "type": "color-input",
        "title": "COLOR",
        "initialValue": "#0e2654"
      },
      "gurbani-font": {
        "title": "FONT",
        "options": {
          "Anmol Lipi": "Anmol Lipi",
          "Anmol Lipi Bold": "Anmol Lipi Bold",
          "Noto Sans": "Noto Sans",
          "Noto Sans Bold": "Noto Sans Bold",
          "Gurbani Akhar": "Gurbani Akhar",
          "Gurbani Akhar Heavy": "Gurbani Akhar Heavy",
          "Gurbani Akhar Thick": "Gurbani Akhar Thick",
          "Prabhki": "Prabhki"
        },
        "initialValue": "Gurbani Akhar Thick"
      },
      "overlayLarivaar": {
        "title": "LARIVAAR",
        "initialValue": false
      },
      "fit-text-switch": {
        "title": "FIT_TEXT",
        "hint": "FIT_TEXT_HINT",
        "layouts": ["top", "bottom"],
        "layoutsHint": "FIT_TEXT_LAYOUT_HINT",
        "initialValue": false
      },
      "toggle-announcement": {
        "title": "MISC_SLIDE_ANNOUNCEMENT",
        "initialValue": true
      },
      "larivaarAssist": {
        "title": "LARIVAAR_ASSIST",
        "requires": "overlayLarivaar",
        "initialValue": false
      },
      "gurbani-size": {
        "title": "SIZE",
        "type": "size-icon",
        "initialValue": 5,
        "max": 15,
        "min": 1,
        "step": 0.25,
        "disableOnChange": ["fit-text-switch"]
      },
      "text-color": {
        "type": "color-input",
        "title": "COLOR",
        "initialValue": "#003a8c"
      },
      "text-font": {
        "title": "FONT",
        "options": {
          "Muli": "Muli",
          "Caveat": "Caveat",
          "PT Serif": "PT Serif"
        },
        "initialValue": "Muli"
      },
      "text-size": {
        "title": "SIZE",
        "type": "size-icon",
        "initialValue": 3,
        "max": 14,
        "min": 1,
        "step": 0.25,
        "disableOnChange": ["fit-text-switch"]
      },
      "text-format": {
        "title": "TEXT_FORMAT",
        "type": "text-format-icon",
        "initialValue": { "bold": false, "italic": false }
      },
      "bg-color": {
        "title": "COLOR",
        "type": "color-input",
        "initialValue": "#97d6f7"
      },
      "padding": {
        "title": "HEIGHT",
        "type": "slider",
        "initialValue": 0.5,
        "max": 5,
        "min": 0.5,
        "step": 0.1,
        "disableOnChange": ["fit-text-switch"]
      },
      "bg-opacity": {
        "title": "OPACITY",
        "type": "slider",
        "format": "percent",
        "initialValue": 1,
        "max": 1,
        "min": 0.1,
        "step": 0.1
      },
      "overlay-theme": {
        "title": "",
        "key": "ThemeSelector",
        "initialValue": "a-new-day"
      },

      "date-format": {
        "title": "",
        "options": {
          "format1": "MM_DD_YYYY",
          "format2": "MM_DD_YYYY",
          "format3": "MM_DD_YYYY"
        },
        "initialValue": "format1"
      },
      "time-format": {
        "title": "",
        "options": {
          "format1": "12HR",
          "format2": "24HR"
        },
        "initialValue": "format1"
      }
    }
  },
  "bottomBar": {
    "categories": {
      "layout-options": {
        "title": "",
        "type": "title",
        "subcategories": ["layouts"]
      },
      "layouts": {
        "title": "LAYOUT",
        "type": "custom",
        "settings": ["layout"]
      },
      "addon-options": {
        "title": "",
        "type": "title",
        "subcategories": ["addons"]
      },
      "addons": {
        "title": "",
        "type": "switch",
        "settings": ["toggle-logo", "green-screen-toggle"]
      }
    },

    "settings": {
      "reset": {
        "icon": "reset.svg",
        "tooltip": "Reset Defaults",
        "initialValue": false
      },
      "layout": {
        "key": "LayoutSelector",
        "initialValue": "split",
        "options": {
          "top": { "label": "LAYOUT_TOP", "icon": [[0, 0, 34, 6]] },
          "bottom": { "label": "LAYOUT_BOTTOM", "icon": [[0, 14, 34, 6]] },
          "split": { "label": "LAYOUT_SPLIT", "icon": [[0, 0, 34, 4], [0, 16, 34, 4]] },
          "vertical-left": { "label": "LAYOUT_VERTICAL_LEFT", "icon": [[0, 0, 17, 20]] },
          "vertical": { "label": "LAYOUT_VERTICAL", "icon": [[17, 0, 17, 20]] },
          "classic": { "label": "LAYOUT_CLASSIC", "icon": [[4, 12, 26, 5, 1.5]] }
        }
      },
      "toggle-logo": {
        "title": "LOGO",
        "initialValue": false
      },
      "toggle-link": {
        "icon": "rectangle.svg",
        "initialValue": false
      },
      "green-screen-toggle": {
        "title": "GREEN_SCREEN",
        "initialValue": false
      }
    }
  }
}
